{
  "framework": "nextjs",
  "buildCommand": "yarn build",
  "outputDirectory": "out",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://app.safe.global; object-src 'none'; base-uri 'self'"
        }
      ]
    }
  ]
}
