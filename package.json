{
  "name": "agave-frontend-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "analyze": "ANALYZE=true yarn build",
    "build": "yarn typechain && next build",
    "export": "yarn build",
    "dev": "next dev",
    "lint": "eslint pages src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint --fix \"./**/*.{js,jsx,ts,tsx}\"",
    "prepare": "husky install",
    "prettier:fix": "prettier --write \"./**/*.{js,jsx,ts,tsx}\"",
    "typechain": "typechain --target ethers-v5 \"./src/contracts/abis/**/*.json\" --out-dir ./types/generated/typechain",
    "types-gen": "yarn typechain",
    "postinstall": "yarn typechain",
    "test": "yarn typechain && jest --runInBand",
    "typecheck": "yarn typechain && tsc --noEmit"
  },
  "dependencies": {
    "@uniswap/sdk-core": "^3.2.6",
    "@uniswap/token-lists": "1.0.0-beta.34",
    "@web3-onboard/core": "^2.24.1",
    "@web3-onboard/gnosis": "^2.3.2",
    "@web3-onboard/injected-wallets": "^2.11.3",
    "@web3-onboard/react": "^2.11.0",
    "big-number-input": "^1.0.3",
    "ethers": "^5.8.0",
    "lodash": "^4.18.1",
    "memoizee": "^0.4.17",
    "next": "^15.5.27",
    "nextjs-google-analytics": "^2.3.7",
    "nullthrows": "^1.1.1",
    "polished": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^3.1.4",
    "react-hot-toast": "^2.6.1",
    "react-tooltip": "^5.30.1",
    "recharts": "^2.15.4",
    "sanitize.css": "^13.0.0",
    "styled-components": "^5.3.11",
    "swr": "^2.5.1",
    "@ethersproject/constants": "^5.8.0",
    "@ethersproject/bignumber": "^5.8.0",
    "@ethersproject/logger": "^5.8.0",
    "@ethersproject/units": "^5.8.0",
    "@ethersproject/providers": "^5.8.0",
    "@ethersproject/contracts": "^5.8.0",
    "@ethersproject/address": "^5.8.0",
    "@safe-global/safe-apps-sdk": "^8.1.0",
    "@safe-global/safe-apps-provider": "^0.18.6",
    "@ethersproject/abi": "^5.8.0",
    "react-is": "^18.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.3.0",
    "@commitlint/config-conventional": "^17.3.0",
    "@next/bundle-analyzer": "^15.5.27",
    "@typechain/ethers-v5": "^11.1.2",
    "@types/jest": "^29.5.0",
    "@types/lodash": "^4.14.191",
    "@types/memoizee": "^0.4.8",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/styled-components": "^5.1.26",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.27",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-jsx-a11y": "^6.6.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-sort-destructure-keys": "^1.4.0",
    "husky": "^8.0.2",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.7",
    "prettier": "^2.8.1",
    "typechain": "^8.3.2",
    "typescript": "~5.9.3",
    "@types/node": "^24.0.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --cache --fix",
      "prettier --write",
      "bash -c tsc"
    ]
  },
  "resolutions": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "ethers": "^5.8.0",
    "**/bnc-sdk/crypto-es": "2.1.0",
    "**/@web3-onboard/core/nanoid": "5.1.16",
    "**/@web3-onboard/core/joi": "17.13.8",
    "**/@web3-onboard/common/joi": "17.13.8",
    "**/@ethersproject/providers/ws": "8.22.0",
    "**/viem/ws": "8.22.0",
    "**/next/postcss": "8.5.30"
  },
  "packageManager": "yarn@1.22.22"
}
